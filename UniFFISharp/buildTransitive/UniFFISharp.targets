<Project>

  <!-- ===================================================================== -->
  <!-- Transitive native static library resolution for NativeAOT publish     -->
  <!-- ===================================================================== -->
  <Target Name="ResolveTransitiveUniFFINativeLibraries"
          BeforeTargets="ComputeIlcLinkerArgs;IlcCompile;LinkNative"
          Condition="'$(PublishAot)' == 'true'">

    <!-- Query all referenced projects for their UniFFI native static libraries -->
    <MSBuild Projects="@(ProjectReference)"
             Targets="GetUniFFINativeDependencies"
             SkipNonexistentTargets="true"
             SkipNonexistentProjects="true"
             Condition="'@(ProjectReference)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_CollectedUniFFINativeLibs" />
    </MSBuild>

    <!-- Inject resolved static libraries and DirectPInvoke into NativeAOT linker context -->
    <ItemGroup Condition="'@(_CollectedUniFFINativeLibs)' != ''">
      <NativeLibrary Include="@(_CollectedUniFFINativeLibs)" />
      <DirectPInvoke Include="%(_CollectedUniFFINativeLibs.CrateLibName)" />

      <!-- Required Windows system libraries for Rust static linking -->
      <NativeLibrary Include="ws2_32.lib;iphlpapi.lib;userenv.lib;bcrypt.lib"
                     Condition="'$(_UniFFITargetOS)' == 'Windows' or $([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>

    <Message Importance="high"
             Text="[UniFFISharp] Resolved transitive static libraries for NativeAOT: @(_CollectedUniFFINativeLibs)"
             Condition="'@(_CollectedUniFFINativeLibs)' != ''" />
  </Target>

</Project>
