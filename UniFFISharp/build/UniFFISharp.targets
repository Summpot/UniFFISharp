<Project>

  <!-- Normalize properties from UniFFISharp prefixes if set -->
  <PropertyGroup>
    <UniFFICargoProject Condition="'$(UniFFICargoProject)' == '' and '$(UniFFISharpCargoProject)' != ''">$(UniFFISharpCargoProject)</UniFFICargoProject>
    <UniFFICrateName Condition="'$(UniFFICrateName)' == '' and '$(UniFFISharpCrateName)' != ''">$(UniFFISharpCrateName)</UniFFICrateName>
    <UniFFINamespace Condition="'$(UniFFINamespace)' == '' and '$(UniFFISharpNamespace)' != ''">$(UniFFISharpNamespace)</UniFFINamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFICargoManifestPath)' == ''">
    <!-- If UniFFICargoProject is set, resolve it relative to project directory -->
    <_UniFFICargoProjectCandidate Condition="'$(UniFFICargoProject)' != '' and !$([System.IO.Path]::IsPathRooted('$(UniFFICargoProject)'))">$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(UniFFICargoProject)"))'))</_UniFFICargoProjectCandidate>
    <_UniFFICargoProjectCandidate Condition="'$(UniFFICargoProject)' != '' and $([System.IO.Path]::IsPathRooted('$(UniFFICargoProject)'))">$([System.IO.Path]::GetFullPath('$(UniFFICargoProject)'))</_UniFFICargoProjectCandidate>

    <!-- If candidate is a file (Cargo.toml) -->
    <UniFFICargoManifestPath Condition="'$(_UniFFICargoProjectCandidate)' != '' and Exists('$(_UniFFICargoProjectCandidate)') and !HasTrailingSlash('$(_UniFFICargoProjectCandidate)') and $([System.String]::Copy('$(_UniFFICargoProjectCandidate)').EndsWith('.toml'))">$(_UniFFICargoProjectCandidate)</UniFFICargoManifestPath>
    <!-- If candidate is a directory containing Cargo.toml -->
    <UniFFICargoManifestPath Condition="'$(_UniFFICargoProjectCandidate)' != '' and Exists('$(_UniFFICargoProjectCandidate)\Cargo.toml')">$([System.IO.Path]::GetFullPath('$(_UniFFICargoProjectCandidate)\Cargo.toml'))</UniFFICargoManifestPath>

    <!-- Convention fallback: search project directory and parent directories -->
    <UniFFICargoManifestPath Condition="'$(UniFFICargoManifestPath)' == '' and Exists('$(MSBuildProjectDirectory)\Cargo.toml')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\Cargo.toml'))</UniFFICargoManifestPath>
    <UniFFICargoManifestPath Condition="'$(UniFFICargoManifestPath)' == '' and Exists('$(MSBuildProjectDirectory)\..\Cargo.toml')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Cargo.toml'))</UniFFICargoManifestPath>
    <UniFFICargoManifestPath Condition="'$(UniFFICargoManifestPath)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\Cargo.toml')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\Cargo.toml'))</UniFFICargoManifestPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFICargoManifestPath)' != '' and Exists('$(UniFFICargoManifestPath)')">
    <UniFFICargoManifestDir>$([System.IO.Path]::GetDirectoryName('$(UniFFICargoManifestPath)'))</UniFFICargoManifestDir>
  </PropertyGroup>

  <!-- ===================================================================== -->
  <!-- 2. Crate Name & Library Name Resolution                               -->
  <!-- ===================================================================== -->
  <PropertyGroup Condition="'$(UniFFICrateName)' == '' and '$(UniFFICargoManifestPath)' != '' and Exists('$(UniFFICargoManifestPath)')">
    <_CargoTomlContent>$([System.IO.File]::ReadAllText('$(UniFFICargoManifestPath)'))</_CargoTomlContent>
    <!-- Priority: [lib] name first, then [package] name -->
    <_CargoLibNameMatch>$([System.Text.RegularExpressions.Regex]::Match('$(_CargoTomlContent)', '\[lib\][^\[]*?name\s*=\s*"([^"]+)"', System.Text.RegularExpressions.RegexOptions.Singleline).Groups[1].Value.Trim())</_CargoLibNameMatch>
    <_CargoPackageNameMatch>$([System.Text.RegularExpressions.Regex]::Match('$(_CargoTomlContent)', '\[package\][^\[]*?name\s*=\s*"([^"]+)"', System.Text.RegularExpressions.RegexOptions.Singleline).Groups[1].Value.Trim())</_CargoPackageNameMatch>
    <UniFFICrateName Condition="'$(_CargoLibNameMatch)' != ''">$(_CargoLibNameMatch)</UniFFICrateName>
    <UniFFICrateName Condition="'$(_CargoLibNameMatch)' == '' and '$(_CargoPackageNameMatch)' != ''">$(_CargoPackageNameMatch)</UniFFICrateName>
  </PropertyGroup>

  <!-- Rust library filename replaces '-' with '_' -->
  <PropertyGroup Condition="'$(UniFFICrateName)' != '' and '$(UniFFICrateLibName)' == ''">
    <UniFFICrateLibName>$(UniFFICrateName.Replace('-', '_'))</UniFFICrateLibName>
  </PropertyGroup>

  <!-- ===================================================================== -->
  <!-- 3. Cargo Target Directory & Output Path Resolution                    -->
  <!-- ===================================================================== -->
  <PropertyGroup Condition="'$(UniFFICargoManifestDir)' != ''">
    <UniFFICargoTargetDir Condition="'$(UniFFICargoTargetDir)' == '' and '$(CARGO_TARGET_DIR)' != ''">$([System.IO.Path]::GetFullPath('$(CARGO_TARGET_DIR)'))</UniFFICargoTargetDir>
    <UniFFICargoTargetDir Condition="'$(UniFFICargoTargetDir)' == '' and Exists('$(UniFFICargoManifestDir)\target')">$([System.IO.Path]::GetFullPath('$(UniFFICargoManifestDir)\target'))</UniFFICargoTargetDir>
    <UniFFICargoTargetDir Condition="'$(UniFFICargoTargetDir)' == '' and Exists('$(UniFFICargoManifestDir)\..\target')">$([System.IO.Path]::GetFullPath('$(UniFFICargoManifestDir)\..\target'))</UniFFICargoTargetDir>
    <UniFFICargoTargetDir Condition="'$(UniFFICargoTargetDir)' == ''">$([System.IO.Path]::GetFullPath('$(UniFFICargoManifestDir)\target'))</UniFFICargoTargetDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFICargoProfile)' == ''">
    <UniFFICargoProfile Condition="'$(Configuration)' == 'Release'">release</UniFFICargoProfile>
    <UniFFICargoProfile Condition="'$(Configuration)' != 'Release'">debug</UniFFICargoProfile>
  </PropertyGroup>

  <!-- Resolve Target OS based on RuntimeIdentifier first, fallback to Host OS -->
  <PropertyGroup>
    <_UniFFITargetOS Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">Windows</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">Linux</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))">OSX</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(_UniFFITargetOS)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(_UniFFITargetOS)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(_UniFFITargetOS)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">OSX</_UniFFITargetOS>

    <!-- Map RuntimeIdentifier to Cargo target when cross-compiling or targeting specific RID -->
    <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == '' and '$(RuntimeIdentifier)' == 'win-x64'">x86_64-pc-windows-msvc</UniFFICargoTarget>
    <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == '' and '$(RuntimeIdentifier)' == 'win-arm64'">aarch64-pc-windows-msvc</UniFFICargoTarget>
    <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == '' and ('$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux')">x86_64-unknown-linux-gnu</UniFFICargoTarget>
    <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == '' and ('$(RuntimeIdentifier)' == 'linux-musl-x64' or '$(RuntimeIdentifier)' == 'alpine-x64')">x86_64-unknown-linux-musl</UniFFICargoTarget>
    <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == '' and '$(RuntimeIdentifier)' == 'linux-arm64'">aarch64-unknown-linux-gnu</UniFFICargoTarget>
    <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == '' and '$(RuntimeIdentifier)' == 'osx-x64'">x86_64-apple-darwin</UniFFICargoTarget>
    <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == '' and '$(RuntimeIdentifier)' == 'osx-arm64'">aarch64-apple-darwin</UniFFICargoTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFICargoTargetDir)' != '' and '$(UniFFICargoProfile)' != ''">
    <UniFFICargoOutputDir Condition="'$(UniFFICargoTarget)' != ''">$([System.IO.Path]::Combine('$(UniFFICargoTargetDir)', '$(UniFFICargoTarget)', '$(UniFFICargoProfile)'))</UniFFICargoOutputDir>
    <UniFFICargoOutputDir Condition="'$(UniFFICargoTarget)' == ''">$([System.IO.Path]::Combine('$(UniFFICargoTargetDir)', '$(UniFFICargoProfile)'))</UniFFICargoOutputDir>
  </PropertyGroup>

  <!-- ===================================================================== -->
  <!-- 4. Default Native Library Paths Resolution per OS                     -->
  <!-- ===================================================================== -->

  <PropertyGroup Condition="'$(UniFFICargoOutputDir)' != '' and '$(UniFFICrateLibName)' != ''">
    <!-- Windows -->
    <UniFFIRustLibrary Condition="'$(UniFFIRustLibrary)' == '' and '$(_UniFFITargetOS)' == 'Windows'">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', '$(UniFFICrateLibName).dll'))</UniFFIRustLibrary>
    <UniFFIRustStaticLibrary Condition="'$(UniFFIRustStaticLibrary)' == '' and '$(_UniFFITargetOS)' == 'Windows'">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', '$(UniFFICrateLibName).lib'))</UniFFIRustStaticLibrary>
    <UniFFIRustLibraryPdb Condition="'$(UniFFIRustLibraryPdb)' == '' and '$(_UniFFITargetOS)' == 'Windows'">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', '$(UniFFICrateLibName).pdb'))</UniFFIRustLibraryPdb>

    <!-- Linux -->
    <UniFFIRustLibrary Condition="'$(UniFFIRustLibrary)' == '' and '$(_UniFFITargetOS)' == 'Linux'">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', 'lib$(UniFFICrateLibName).so'))</UniFFIRustLibrary>
    <UniFFIRustStaticLibrary Condition="'$(UniFFIRustStaticLibrary)' == '' and '$(_UniFFITargetOS)' == 'Linux'">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', 'lib$(UniFFICrateLibName).a'))</UniFFIRustStaticLibrary>

    <!-- macOS -->
    <UniFFIRustLibrary Condition="'$(UniFFIRustLibrary)' == '' and '$(_UniFFITargetOS)' == 'OSX'">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', 'lib$(UniFFICrateLibName).dylib'))</UniFFIRustLibrary>
    <UniFFIRustStaticLibrary Condition="'$(UniFFIRustStaticLibrary)' == '' and '$(_UniFFITargetOS)' == 'OSX'">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', 'lib$(UniFFICrateLibName).a'))</UniFFIRustStaticLibrary>
  </PropertyGroup>

  <!-- Default UniFFILinkMode to Auto if not set -->
  <PropertyGroup>
    <UniFFILinkMode Condition="'$(UniFFILinkMode)' == ''">Auto</UniFFILinkMode>
  </PropertyGroup>

  <!-- ===================================================================== -->
  <!-- 5. Static Link Mode / NativeAOT & Dynamic Link Setup                  -->
  <!-- ===================================================================== -->
  <Choose>
    <When Condition="'$(UniFFILinkMode)' == 'Static' or ('$(UniFFILinkMode)' == 'Auto' and '$(PublishAot)' == 'true')">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);UNIFFI_STATIC_LINK</DefineConstants>
        <_UniFFIIsStaticLink>true</_UniFFIIsStaticLink>
      </PropertyGroup>

      <!-- Common Windows system libraries required by Rust std when statically linking on Windows -->
      <ItemGroup Condition="'$(_UniFFITargetOS)' == 'Windows'">
        <NativeLibrary Include="ws2_32.lib" />
        <NativeLibrary Include="iphlpapi.lib" />
        <NativeLibrary Include="userenv.lib" />
        <NativeLibrary Include="bcrypt.lib" />
      </ItemGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <_UniFFIIsStaticLink>false</_UniFFIIsStaticLink>
      </PropertyGroup>
      <!-- Dynamic linking: copy .dll / .so / .dylib and pdb to output directory if exists -->
      <ItemGroup Condition="'$(UniFFIRustLibrary)' != '' and Exists('$(UniFFIRustLibrary)') and ($([System.String]::Copy('$(UniFFIRustLibrary)').EndsWith('.dll')) or $([System.String]::Copy('$(UniFFIRustLibrary)').EndsWith('.so')) or $([System.String]::Copy('$(UniFFIRustLibrary)').EndsWith('.dylib')))">
        <None Include="$(UniFFIRustLibrary)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
        <None Include="$(UniFFIRustLibraryPdb)" Condition="'$(UniFFICopyPdb)' != 'false' and '$(UniFFIRustLibraryPdb)' != '' and Exists('$(UniFFIRustLibraryPdb)')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- Register resolved libraries into AdditionalFiles for UniFFIGenerator -->
  <ItemGroup Condition="'$(_UniFFIIsStaticLink)' != 'true' and '$(UniFFIRustLibrary)' != ''">
    <AdditionalFiles Include="$(UniFFIRustLibrary)" UniFFI="true" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(_UniFFIIsStaticLink)' == 'true' and '$(UniFFIRustStaticLibrary)' != ''">
    <AdditionalFiles Include="$(UniFFIRustStaticLibrary)" UniFFI="true" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(_UniFFIIsStaticLink)' == 'true' and '$(UniFFIRustStaticLibrary)' == '' and '$(UniFFIRustLibrary)' != '' and ($([System.String]::Copy('$(UniFFIRustLibrary)').EndsWith('.lib')) or $([System.String]::Copy('$(UniFFIRustLibrary)').EndsWith('.a')))">
    <AdditionalFiles Include="$(UniFFIRustLibrary)" UniFFI="true" Visible="false" />
  </ItemGroup>

  <!-- ===================================================================== -->
  <!-- 6. Target: Cargo Auto-Build                                           -->
  <!-- ===================================================================== -->
  <Target Name="UniFFIBuildCargo"
          BeforeTargets="BeforeCompile;CoreCompile;GenerateMSBuildEditorConfigFileCore;AssignTargetPaths"
          Condition="'$(UniFFIAutoBuildCargo)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(BuildingForLiveUnitTesting)' != 'true' and '$(UniFFICargoManifestPath)' != '' and Exists('$(UniFFICargoManifestPath)')">

    <PropertyGroup>
      <_CargoExecutable Condition="'$(_CargoExecutable)' == ''">cargo</_CargoExecutable>
      <_CargoSubCommand Condition="'$(_UniFFIIsStaticLink)' == 'true'">rustc</_CargoSubCommand>
      <_CargoSubCommand Condition="'$(_UniFFIIsStaticLink)' != 'true'">build</_CargoSubCommand>
      <_CargoCommand>$(_CargoExecutable) $(_CargoSubCommand) --manifest-path "$(UniFFICargoManifestPath)"</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoProfile)' == 'release'">$(_CargoCommand) --release</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoTarget)' != ''">$(_CargoCommand) --target $(UniFFICargoTarget)</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICrateName)' != '' and '$(UniFFICargoPackageSpecified)' != 'false'">$(_CargoCommand) --package $(UniFFICrateName)</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoFeatures)' != ''">$(_CargoCommand) --features $(UniFFICargoFeatures)</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoNoDefaultFeatures)' == 'true'">$(_CargoCommand) --no-default-features</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoBuildArgs)' != ''">$(_CargoCommand) $(UniFFICargoBuildArgs)</_CargoCommand>
      <_CargoCommand Condition="'$(_UniFFIIsStaticLink)' == 'true'">$(_CargoCommand) --crate-type staticlib</_CargoCommand>

      <!-- Fallback resolution for ZigPath if not set by targets -->
      <ZigPath Condition="'$(ZigPath)' == '' and '$(PkgVezel_Zig_Toolsets_win_x64)' != '' and Exists('$(PkgVezel_Zig_Toolsets_win_x64)\tools')">$(PkgVezel_Zig_Toolsets_win_x64)\tools</ZigPath>
      <ZigPath Condition="'$(ZigPath)' == '' and '$(PkgVezel_Zig_Toolsets_win-x64)' != '' and Exists('$(PkgVezel_Zig_Toolsets_win-x64)\tools')">$(PkgVezel_Zig_Toolsets_win-x64)\tools</ZigPath>
      <ZigPath Condition="'$(ZigPath)' == '' and '$(PkgVezel_Zig_Toolsets_win_arm64)' != '' and Exists('$(PkgVezel_Zig_Toolsets_win_arm64)\tools')">$(PkgVezel_Zig_Toolsets_win_arm64)\tools</ZigPath>
      <ZigPath Condition="'$(ZigPath)' == '' and '$(PkgVezel_Zig_Toolsets_win-arm64)' != '' and Exists('$(PkgVezel_Zig_Toolsets_win-arm64)\tools')">$(PkgVezel_Zig_Toolsets_win-arm64)\tools</ZigPath>

      <!-- Prepend ZigPath if available for cross-compilation tools (cc.exe) -->
      <_UniFFIEnvPath Condition="'$(ZigPath)' != ''">$(ZigPath);$([System.Environment]::GetEnvironmentVariable('PATH'))</_UniFFIEnvPath>
      <_UniFFIEnvPath Condition="'$(_UniFFIEnvPath)' == ''">$([System.Environment]::GetEnvironmentVariable('PATH'))</_UniFFIEnvPath>

      <_UniFFITargetTriple Condition="'$(TargetTriple)' != ''">$(TargetTriple)</_UniFFITargetTriple>
      <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == '' and ('$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux')">x86_64-linux-gnu</_UniFFITargetTriple>
      <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == '' and '$(RuntimeIdentifier)' == 'linux-arm64'">aarch64-linux-gnu</_UniFFITargetTriple>
      <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == '' and '$(RuntimeIdentifier)' == 'linux-musl-x64'">x86_64-linux-musl</_UniFFITargetTriple>
      <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == '' and '$(RuntimeIdentifier)' == 'linux-musl-arm64'">aarch64-linux-musl</_UniFFITargetTriple>
      <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == '' and '$(RuntimeIdentifier)' == 'osx-x64'">x86_64-macos</_UniFFITargetTriple>
      <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == '' and '$(RuntimeIdentifier)' == 'osx-arm64'">aarch64-macos</_UniFFITargetTriple>

      <_UniFFIEnvPathEscaped Condition="'$(_UniFFIEnvPath)' != ''">$(_UniFFIEnvPath.Replace(';', '%3B'))</_UniFFIEnvPathEscaped>
    </PropertyGroup>

    <Message Importance="high" Text="[UniFFISharp] Building Rust crate '$(UniFFICrateName)' via Cargo ($(_CargoCommand))..." />

    <Exec Command="$(_CargoCommand)"
          WorkingDirectory="$(UniFFICargoManifestDir)"
          EnvironmentVariables="PATH=$(_UniFFIEnvPathEscaped);TARGET_TRIPLE=$(_UniFFITargetTriple)"
          StandardOutputImportance="Normal"
          StandardErrorImportance="Normal" />

  </Target>

  <!-- ===================================================================== -->
  <!-- 7. Target: Dynamically Register Output Files & Generator Inputs       -->
  <!-- ===================================================================== -->
  <Target Name="UniFFIRegisterOutputFiles"
          AfterTargets="UniFFIBuildCargo"
          BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems;CoreCompile">

    <!-- Dynamic linking copy items -->
    <ItemGroup Condition="('$(UniFFILinkMode)' == 'Dynamic' or ('$(UniFFILinkMode)' == 'Auto' and '$(PublishAot)' != 'true')) and '$(UniFFIRustLibrary)' != '' and Exists('$(UniFFIRustLibrary)')">
      <None Include="$(UniFFIRustLibrary)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>$([System.IO.Path]::GetFileName('$(UniFFIRustLibrary)'))</TargetPath>
        <Visible>false</Visible>
      </None>
      <None Include="$(UniFFIRustLibraryPdb)" Condition="'$(UniFFICopyPdb)' != 'false' and '$(UniFFIRustLibraryPdb)' != '' and Exists('$(UniFFIRustLibraryPdb)')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>$([System.IO.Path]::GetFileName('$(UniFFIRustLibraryPdb)'))</TargetPath>
        <Visible>false</Visible>
      </None>
    </ItemGroup>

    <!-- Static linking / NativeAOT items -->
    <ItemGroup Condition="('$(UniFFILinkMode)' == 'Static' or ('$(UniFFILinkMode)' == 'Auto' and '$(PublishAot)' == 'true')) and '$(UniFFIRustStaticLibrary)' != '' and Exists('$(UniFFIRustStaticLibrary)')">
      <NativeLibrary Include="$(UniFFIRustStaticLibrary)" />
      <DirectPInvoke Include="$([System.IO.Path]::GetFileNameWithoutExtension('$(UniFFIRustStaticLibrary)'))" />
    </ItemGroup>

    <!-- Update AdditionalFiles for Roslyn Source Generator if newly created -->
    <ItemGroup Condition="'$(_UniFFIIsStaticLink)' != 'true' and '$(UniFFIRustLibrary)' != '' and Exists('$(UniFFIRustLibrary)')">
      <AdditionalFiles Include="$(UniFFIRustLibrary)" UniFFI="true" Visible="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(_UniFFIIsStaticLink)' == 'true' and '$(UniFFIRustStaticLibrary)' != '' and Exists('$(UniFFIRustStaticLibrary)')">
      <AdditionalFiles Include="$(UniFFIRustStaticLibrary)" UniFFI="true" Visible="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(_UniFFIIsStaticLink)' == 'true' and '$(UniFFIRustStaticLibrary)' == '' and '$(UniFFIRustLibrary)' != '' and Exists('$(UniFFIRustLibrary)') and ($([System.String]::Copy('$(UniFFIRustLibrary)').EndsWith('.lib')) or $([System.String]::Copy('$(UniFFIRustLibrary)').EndsWith('.a')))">
      <AdditionalFiles Include="$(UniFFIRustLibrary)" UniFFI="true" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================== -->
  <!-- 8. Target: Cargo Clean                                                -->
  <!-- ===================================================================== -->
  <Target Name="UniFFICleanCargo"
          AfterTargets="Clean"
          Condition="'$(UniFFICargoClean)' == 'true' and '$(UniFFICargoManifestPath)' != '' and Exists('$(UniFFICargoManifestPath)')">
    <PropertyGroup>
      <_CargoExecutable Condition="'$(_CargoExecutable)' == ''">cargo</_CargoExecutable>
      <_CargoCleanCommand>$(_CargoExecutable) clean --manifest-path "$(UniFFICargoManifestPath)"</_CargoCleanCommand>
      <_CargoCleanCommand Condition="'$(UniFFICrateName)' != '' and '$(UniFFICargoPackageSpecified)' != 'false'">$(_CargoCleanCommand) --package $(UniFFICrateName)</_CargoCleanCommand>
    </PropertyGroup>

    <Message Importance="high" Text="[UniFFISharp] Cleaning Rust crate '$(UniFFICrateName)' via Cargo ($(_CargoCleanCommand))..." />
    <Exec Command="$(_CargoCleanCommand)"
          WorkingDirectory="$(UniFFICargoManifestDir)"
          ContinueOnError="true" />
  </Target>

</Project>
