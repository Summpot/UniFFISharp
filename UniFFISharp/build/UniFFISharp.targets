<Project>

  <!-- ===================================================================== -->
  <!-- Cargo manifest                                                        -->
  <!-- ===================================================================== -->
  <PropertyGroup Condition="'$(UniFFICargoManifestPath)' == ''">
    <_UniFFICargoProjectCandidate Condition="'$(UniFFICargoProject)' != '' and !$([System.IO.Path]::IsPathRooted('$(UniFFICargoProject)'))">$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(UniFFICargoProject)"))'))</_UniFFICargoProjectCandidate>
    <_UniFFICargoProjectCandidate Condition="'$(UniFFICargoProject)' != '' and $([System.IO.Path]::IsPathRooted('$(UniFFICargoProject)'))">$([System.IO.Path]::GetFullPath('$(UniFFICargoProject)'))</_UniFFICargoProjectCandidate>

    <UniFFICargoManifestPath Condition="'$(_UniFFICargoProjectCandidate)' != '' and Exists('$(_UniFFICargoProjectCandidate)') and !HasTrailingSlash('$(_UniFFICargoProjectCandidate)') and $([System.String]::Copy('$(_UniFFICargoProjectCandidate)').EndsWith('.toml'))">$(_UniFFICargoProjectCandidate)</UniFFICargoManifestPath>
    <UniFFICargoManifestPath Condition="'$(_UniFFICargoProjectCandidate)' != '' and Exists('$(_UniFFICargoProjectCandidate)\Cargo.toml')">$([System.IO.Path]::GetFullPath('$(_UniFFICargoProjectCandidate)\Cargo.toml'))</UniFFICargoManifestPath>

    <UniFFICargoManifestPath Condition="'$(UniFFICargoManifestPath)' == '' and Exists('$(MSBuildProjectDirectory)\Cargo.toml')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\Cargo.toml'))</UniFFICargoManifestPath>
    <UniFFICargoManifestPath Condition="'$(UniFFICargoManifestPath)' == '' and Exists('$(MSBuildProjectDirectory)\..\Cargo.toml')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Cargo.toml'))</UniFFICargoManifestPath>
    <UniFFICargoManifestPath Condition="'$(UniFFICargoManifestPath)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\Cargo.toml')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\Cargo.toml'))</UniFFICargoManifestPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFICargoManifestPath)' != '' and Exists('$(UniFFICargoManifestPath)')">
    <UniFFICargoManifestDir>$([System.IO.Path]::GetDirectoryName('$(UniFFICargoManifestPath)'))</UniFFICargoManifestDir>
    <_CargoTomlContent>$([System.IO.File]::ReadAllText('$(UniFFICargoManifestPath)'))</_CargoTomlContent>
    <_CargoLibNameMatch>$([System.Text.RegularExpressions.Regex]::Match('$(_CargoTomlContent)', '\[lib\][^\[]*?name\s*=\s*"([^"]+)"', System.Text.RegularExpressions.RegexOptions.Singleline).Groups[1].Value.Trim())</_CargoLibNameMatch>
    <_CargoPackageNameMatch>$([System.Text.RegularExpressions.Regex]::Match('$(_CargoTomlContent)', '\[package\][^\[]*?name\s*=\s*"([^"]+)"', System.Text.RegularExpressions.RegexOptions.Singleline).Groups[1].Value.Trim())</_CargoPackageNameMatch>
    <_CargoHasStaticLib Condition="'$(_CargoTomlContent)' != '' and $(_CargoTomlContent.Contains('staticlib'))">true</_CargoHasStaticLib>
  </PropertyGroup>

  <!-- UniFFIPackageName is passed to cargo -p. UniFFICrateLibName is the library file stem. -->
  <PropertyGroup>
    <UniFFIPackageName Condition="'$(UniFFIPackageName)' == '' and '$(UniFFICrateName)' != ''">$(UniFFICrateName)</UniFFIPackageName>
    <UniFFIPackageName Condition="'$(UniFFIPackageName)' == '' and '$(_CargoPackageNameMatch)' != ''">$(_CargoPackageNameMatch)</UniFFIPackageName>
    <UniFFIPackageName Condition="'$(UniFFIPackageName)' == '' and '$(_CargoLibNameMatch)' != ''">$(_CargoLibNameMatch)</UniFFIPackageName>
    <UniFFICrateName Condition="'$(UniFFICrateName)' == ''">$(UniFFIPackageName)</UniFFICrateName>

    <UniFFICrateLibName Condition="'$(UniFFICrateLibName)' == '' and '$(_CargoLibNameMatch)' != ''">$(_CargoLibNameMatch)</UniFFICrateLibName>
    <UniFFICrateLibName Condition="'$(UniFFICrateLibName)' == '' and '$(UniFFIPackageName)' != ''">$(UniFFIPackageName)</UniFFICrateLibName>
    <UniFFICrateLibName Condition="'$(UniFFICrateLibName)' != ''">$(UniFFICrateLibName.Replace('-', '_'))</UniFFICrateLibName>
  </PropertyGroup>

  <!-- One RID row sets the OS, the cargo target, and the Zig cc triple. -->
  <PropertyGroup>
    <_UniFFITargetTriple Condition="'$(TargetTriple)' != ''">$(TargetTriple)</_UniFFITargetTriple>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(RuntimeIdentifier)' == 'win-x64'">
      <PropertyGroup>
        <_UniFFITargetOS>Windows</_UniFFITargetOS>
        <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == ''">x86_64-pc-windows-msvc</UniFFICargoTarget>
      </PropertyGroup>
    </When>
    <When Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
      <PropertyGroup>
        <_UniFFITargetOS>Windows</_UniFFITargetOS>
        <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == ''">aarch64-pc-windows-msvc</UniFFICargoTarget>
      </PropertyGroup>
    </When>
    <When Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux'">
      <PropertyGroup>
        <_UniFFITargetOS>Linux</_UniFFITargetOS>
        <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == ''">x86_64-unknown-linux-gnu</UniFFICargoTarget>
        <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == ''">x86_64-linux-gnu</_UniFFITargetTriple>
      </PropertyGroup>
    </When>
    <When Condition="'$(RuntimeIdentifier)' == 'linux-musl-x64' or '$(RuntimeIdentifier)' == 'alpine-x64'">
      <PropertyGroup>
        <_UniFFITargetOS>Linux</_UniFFITargetOS>
        <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == ''">x86_64-unknown-linux-musl</UniFFICargoTarget>
        <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == ''">x86_64-linux-musl</_UniFFITargetTriple>
      </PropertyGroup>
    </When>
    <When Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
      <PropertyGroup>
        <_UniFFITargetOS>Linux</_UniFFITargetOS>
        <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == ''">aarch64-unknown-linux-gnu</UniFFICargoTarget>
        <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == ''">aarch64-linux-gnu</_UniFFITargetTriple>
      </PropertyGroup>
    </When>
    <When Condition="'$(RuntimeIdentifier)' == 'linux-musl-arm64'">
      <PropertyGroup>
        <_UniFFITargetOS>Linux</_UniFFITargetOS>
        <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == ''">aarch64-unknown-linux-musl</UniFFICargoTarget>
        <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == ''">aarch64-linux-musl</_UniFFITargetTriple>
      </PropertyGroup>
    </When>
    <When Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
      <PropertyGroup>
        <_UniFFITargetOS>OSX</_UniFFITargetOS>
        <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == ''">x86_64-apple-darwin</UniFFICargoTarget>
        <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == ''">x86_64-macos</_UniFFITargetTriple>
      </PropertyGroup>
    </When>
    <When Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
      <PropertyGroup>
        <_UniFFITargetOS>OSX</_UniFFITargetOS>
        <UniFFICargoTarget Condition="'$(UniFFICargoTarget)' == ''">aarch64-apple-darwin</UniFFICargoTarget>
        <_UniFFITargetTriple Condition="'$(_UniFFITargetTriple)' == ''">aarch64-macos</_UniFFITargetTriple>
      </PropertyGroup>
    </When>
  </Choose>
  <PropertyGroup>
    <_UniFFITargetOS Condition="'$(_UniFFITargetOS)' == '' and '$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">Windows</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(_UniFFITargetOS)' == '' and '$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">Linux</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(_UniFFITargetOS)' == '' and '$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))">OSX</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(_UniFFITargetOS)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(_UniFFITargetOS)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</_UniFFITargetOS>
    <_UniFFITargetOS Condition="'$(_UniFFITargetOS)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">OSX</_UniFFITargetOS>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFICargoProfile)' == ''">
    <UniFFICargoProfile Condition="'$(Configuration)' == 'Release'">release</UniFFICargoProfile>
    <UniFFICargoProfile Condition="'$(Configuration)' != 'Release'">debug</UniFFICargoProfile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFICargoManifestDir)' != ''">
    <UniFFICargoTargetDir Condition="'$(UniFFICargoTargetDir)' == '' and '$(CARGO_TARGET_DIR)' != ''">$([System.IO.Path]::GetFullPath('$(CARGO_TARGET_DIR)'))</UniFFICargoTargetDir>
    <UniFFICargoTargetDir Condition="'$(UniFFICargoTargetDir)' == '' and Exists('$(UniFFICargoManifestDir)\target')">$([System.IO.Path]::GetFullPath('$(UniFFICargoManifestDir)\target'))</UniFFICargoTargetDir>
    <UniFFICargoTargetDir Condition="'$(UniFFICargoTargetDir)' == '' and Exists('$(UniFFICargoManifestDir)\..\target')">$([System.IO.Path]::GetFullPath('$(UniFFICargoManifestDir)\..\target'))</UniFFICargoTargetDir>
    <UniFFICargoTargetDir Condition="'$(UniFFICargoTargetDir)' == ''">$([System.IO.Path]::GetFullPath('$(UniFFICargoManifestDir)\target'))</UniFFICargoTargetDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFICargoTargetDir)' != '' and '$(UniFFICargoProfile)' != ''">
    <UniFFICargoOutputDir Condition="'$(UniFFICargoTarget)' != ''">$([System.IO.Path]::Combine('$(UniFFICargoTargetDir)', '$(UniFFICargoTarget)', '$(UniFFICargoProfile)'))</UniFFICargoOutputDir>
    <UniFFICargoOutputDir Condition="'$(UniFFICargoTarget)' == ''">$([System.IO.Path]::Combine('$(UniFFICargoTargetDir)', '$(UniFFICargoProfile)'))</UniFFICargoOutputDir>
  </PropertyGroup>

  <PropertyGroup>
    <_UniFFILibPrefix Condition="'$(_UniFFITargetOS)' == 'Linux' or '$(_UniFFITargetOS)' == 'OSX'">lib</_UniFFILibPrefix>
    <_UniFFIDynamicExt Condition="'$(_UniFFITargetOS)' == 'Windows'">dll</_UniFFIDynamicExt>
    <_UniFFIDynamicExt Condition="'$(_UniFFITargetOS)' == 'Linux'">so</_UniFFIDynamicExt>
    <_UniFFIDynamicExt Condition="'$(_UniFFITargetOS)' == 'OSX'">dylib</_UniFFIDynamicExt>
    <_UniFFIStaticExt Condition="'$(_UniFFITargetOS)' == 'Windows'">lib</_UniFFIStaticExt>
    <_UniFFIStaticExt Condition="'$(_UniFFITargetOS)' == 'Linux' or '$(_UniFFITargetOS)' == 'OSX'">a</_UniFFIStaticExt>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFICargoOutputDir)' != '' and '$(UniFFICrateLibName)' != '' and '$(_UniFFIDynamicExt)' != ''">
    <UniFFIRustLibrary Condition="'$(UniFFIRustLibrary)' == ''">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', '$(_UniFFILibPrefix)$(UniFFICrateLibName).$(_UniFFIDynamicExt)'))</UniFFIRustLibrary>
    <UniFFIRustStaticLibrary Condition="'$(UniFFIRustStaticLibrary)' == ''">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', '$(_UniFFILibPrefix)$(UniFFICrateLibName).$(_UniFFIStaticExt)'))</UniFFIRustStaticLibrary>
    <UniFFIRustLibraryPdb Condition="'$(UniFFIRustLibraryPdb)' == '' and '$(_UniFFITargetOS)' == 'Windows'">$([System.IO.Path]::Combine('$(UniFFICargoOutputDir)', '$(UniFFICrateLibName).pdb'))</UniFFIRustLibraryPdb>
  </PropertyGroup>

  <!-- UniFFILinkKind determines whether static or dynamic linking is used.
       - 'Static': explicitly force static linking.
       - 'Dynamic': explicitly force dynamic linking.
       - 'Auto' (default): automatically select Static when performing an actual Native AOT publish (PublishAot=true and _IsPublishing=true); otherwise default to Dynamic for ordinary builds, debugging, and testing. -->
  <PropertyGroup>
    <UniFFILinkMode Condition="'$(UniFFILinkMode)' == ''">Auto</UniFFILinkMode>
    <UniFFILinkKind Condition="'$(UniFFILinkMode)' == 'Static' or ('$(UniFFILinkMode)' == 'Auto' and '$(PublishAot)' == 'true' and ('$(_IsPublishing)' == 'true' or '$(DeployOnBuild)' == 'true'))">Static</UniFFILinkKind>
    <UniFFILinkKind Condition="'$(UniFFILinkKind)' == ''">Dynamic</UniFFILinkKind>

    <_UniFFIRustLibraryIsArchive Condition="'$(UniFFIRustLibrary)' != '' and ($([System.String]::Copy('$(UniFFIRustLibrary)').EndsWith('.lib', System.StringComparison.OrdinalIgnoreCase)) or $([System.String]::Copy('$(UniFFIRustLibrary)').EndsWith('.a', System.StringComparison.OrdinalIgnoreCase)))">true</_UniFFIRustLibraryIsArchive>
    <UniFFIRustStaticLibrary Condition="'$(UniFFILinkKind)' == 'Static' and '$(UniFFIRustStaticLibrary)' == '' and '$(_UniFFIRustLibraryIsArchive)' == 'true'">$(UniFFIRustLibrary)</UniFFIRustStaticLibrary>
    <UniFFIRustLibraryPdb Condition="'$(UniFFIRustLibraryPdb)' != '' and !$([System.IO.Path]::IsPathRooted('$(UniFFIRustLibraryPdb)'))">$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(UniFFIRustLibraryPdb)"))'))</UniFFIRustLibraryPdb>
    <UniFFIInputLibrary Condition="'$(UniFFILinkKind)' == 'Static'">$(UniFFIRustStaticLibrary)</UniFFIInputLibrary>
    <UniFFIInputLibrary Condition="'$(UniFFILinkKind)' == 'Dynamic'">$(UniFFIRustLibrary)</UniFFIInputLibrary>
    <UniFFIInputLibrary Condition="'$(UniFFIInputLibrary)' != '' and !$([System.IO.Path]::IsPathRooted('$(UniFFIInputLibrary)'))">$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(UniFFIInputLibrary)"))'))</UniFFIInputLibrary>
    <UniFFIInputLibrary Condition="'$(UniFFIInputLibrary)' != '' and $([System.IO.Path]::IsPathRooted('$(UniFFIInputLibrary)'))">$([System.IO.Path]::GetFullPath('$(UniFFIInputLibrary)'))</UniFFIInputLibrary>
    <UniFFIInputStampFile Condition="'$(UniFFIInputLibrary)' != ''">$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(IntermediateOutputPath)", "uniffi.input.stamp"))'))</UniFFIInputStampFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniFFILinkKind)' == 'Static'">
    <DefineConstants>$(DefineConstants);UNIFFI_STATIC_LINK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UniFFILinkKind)' == 'Static' and '$(_UniFFITargetOS)' == 'Windows'">
    <NativeLibrary Include="ws2_32.lib" />
    <NativeLibrary Include="iphlpapi.lib" />
    <NativeLibrary Include="userenv.lib" />
    <NativeLibrary Include="bcrypt.lib" />
  </ItemGroup>

  <!-- Stamp text is "path|utcTicks". The generator reads this instead of the native binary. -->
  <ItemGroup Condition="'$(UniFFIInputStampFile)' != ''">
    <AdditionalFiles Include="$(UniFFIInputStampFile)" UniFFI="true" Visible="false" />
  </ItemGroup>

  <!-- ===================================================================== -->
  <!-- Cargo build, then one registration of the resolved library            -->
  <!-- ===================================================================== -->
  <Target Name="UniFFIBuildCargo"
          BeforeTargets="UniFFIEmitInput;CoreCompile"
          Condition="'$(UniFFIAutoBuildCargo)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(BuildingForLiveUnitTesting)' != 'true' and '$(UniFFICargoManifestPath)' != '' and Exists('$(UniFFICargoManifestPath)')">

    <PropertyGroup>
      <_CargoExecutable Condition="'$(_CargoExecutable)' == ''">cargo</_CargoExecutable>
      <_CargoSubCommand Condition="'$(UniFFILinkKind)' == 'Static' and '$(_CargoHasStaticLib)' != 'true'">rustc</_CargoSubCommand>
      <_CargoSubCommand Condition="'$(_CargoSubCommand)' == ''">build</_CargoSubCommand>
      <_CargoCommand>$(_CargoExecutable) $(_CargoSubCommand) --manifest-path "$(UniFFICargoManifestPath)"</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoProfile)' == 'release'">$(_CargoCommand) --release</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoTarget)' != ''">$(_CargoCommand) --target $(UniFFICargoTarget)</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFIPackageName)' != '' and '$(UniFFICargoPackageSpecified)' != 'false'">$(_CargoCommand) --package "$(UniFFIPackageName)"</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoFeatures)' != ''">$(_CargoCommand) --features $(UniFFICargoFeatures)</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoNoDefaultFeatures)' == 'true'">$(_CargoCommand) --no-default-features</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFICargoBuildArgs)' != ''">$(_CargoCommand) $(UniFFICargoBuildArgs)</_CargoCommand>
      <_CargoCommand Condition="'$(UniFFILinkKind)' == 'Static' and '$(_CargoHasStaticLib)' != 'true'">$(_CargoCommand) --crate-type staticlib</_CargoCommand>

      <!-- Read here so a target that runs before cargo, such as AotAnywhere, can still set these. -->
      <_UniFFITargetTriple Condition="'$(TargetTriple)' != ''">$(TargetTriple)</_UniFFITargetTriple>
      <_UniFFIEnvPath Condition="'$(ZigPath)' != ''">$(ZigPath);$([System.Environment]::GetEnvironmentVariable('PATH'))</_UniFFIEnvPath>
      <_UniFFIEnvPath Condition="'$(_UniFFIEnvPath)' == ''">$([System.Environment]::GetEnvironmentVariable('PATH'))</_UniFFIEnvPath>
      <_UniFFIEnvPathEscaped Condition="'$(_UniFFIEnvPath)' != ''">$(_UniFFIEnvPath.Replace(';', '%3B'))</_UniFFIEnvPathEscaped>
    </PropertyGroup>

    <Message Importance="high" Text="[UniFFISharp] Building Rust package '$(UniFFIPackageName)' via Cargo ($(_CargoCommand))..." />

    <Exec Command="$(_CargoCommand)"
          WorkingDirectory="$(UniFFICargoManifestDir)"
          EnvironmentVariables="PATH=$(_UniFFIEnvPathEscaped);TARGET_TRIPLE=$(_UniFFITargetTriple)"
          StandardOutputImportance="Normal"
          StandardErrorImportance="Normal" />
  </Target>

  <Target Name="UniFFIEmitInput"
          DependsOnTargets="PrepareForBuild"
          BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile;AssignTargetPaths;GetCopyToOutputDirectoryItems"
          Condition="'$(UniFFIInputLibrary)' != ''">

    <PropertyGroup>
      <_UniFFIInputStamp Condition="Exists('$(UniFFIInputLibrary)')">$([System.IO.File]::GetLastWriteTimeUtc('$(UniFFIInputLibrary)').Ticks)</_UniFFIInputStamp>
      <_UniFFIInputStamp Condition="'$(_UniFFIInputStamp)' == ''">0</_UniFFIInputStamp>
    </PropertyGroup>

    <WriteLinesToFile File="$(UniFFIInputStampFile)"
                      Lines="$(UniFFIInputLibrary)|$(_UniFFIInputStamp)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="UTF-8" />

    <ItemGroup Condition="'$(UniFFILinkKind)' == 'Dynamic' and Exists('$(UniFFIInputLibrary)')">
      <None Include="$(UniFFIInputLibrary)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <TargetPath>$([System.IO.Path]::GetFileName('$(UniFFIInputLibrary)'))</TargetPath>
        <Visible>false</Visible>
      </None>
      <None Include="$(UniFFIRustLibraryPdb)" Condition="'$(UniFFICopyPdb)' != 'false' and '$(UniFFIRustLibraryPdb)' != '' and Exists('$(UniFFIRustLibraryPdb)')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <TargetPath>$([System.IO.Path]::GetFileName('$(UniFFIRustLibraryPdb)'))</TargetPath>
        <Visible>false</Visible>
      </None>
    </ItemGroup>

    <ItemGroup Condition="'$(UniFFILinkKind)' == 'Static' and Exists('$(UniFFIInputLibrary)')">
      <NativeLibrary Include="$(UniFFIInputLibrary)" />
      <DirectPInvoke Include="$([System.IO.Path]::GetFileNameWithoutExtension('$(UniFFIInputLibrary)'))" />
    </ItemGroup>

    <!-- In static linking mode, if a dynamic library also exists, copy it to the local build output directory
         so ordinary execution (dotnet run / test runners) under CoreCLR can still resolve P/Invoke, but avoid copying to publish directory. -->
    <ItemGroup Condition="'$(UniFFILinkKind)' == 'Static' and '$(UniFFIRustLibrary)' != '' and Exists('$(UniFFIRustLibrary)') and '$(_UniFFIRustLibraryIsArchive)' != 'true'">
      <None Include="$(UniFFIRustLibrary)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        <TargetPath>$([System.IO.Path]::GetFileName('$(UniFFIRustLibrary)'))</TargetPath>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

  <Target Name="UniFFICleanCargo"
          AfterTargets="Clean"
          Condition="'$(UniFFICargoClean)' == 'true' and '$(UniFFICargoManifestPath)' != '' and Exists('$(UniFFICargoManifestPath)')">
    <PropertyGroup>
      <_CargoExecutable Condition="'$(_CargoExecutable)' == ''">cargo</_CargoExecutable>
      <_CargoCleanCommand>$(_CargoExecutable) clean --manifest-path "$(UniFFICargoManifestPath)"</_CargoCleanCommand>
      <_CargoCleanCommand Condition="'$(UniFFIPackageName)' != '' and '$(UniFFICargoPackageSpecified)' != 'false'">$(_CargoCleanCommand) --package "$(UniFFIPackageName)"</_CargoCleanCommand>
    </PropertyGroup>

    <Message Importance="high" Text="[UniFFISharp] Cleaning Rust package '$(UniFFIPackageName)' via Cargo ($(_CargoCleanCommand))..." />
    <Exec Command="$(_CargoCleanCommand)"
          WorkingDirectory="$(UniFFICargoManifestDir)"
          ContinueOnError="true" />
  </Target>

</Project>
